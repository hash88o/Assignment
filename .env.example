# --- API keys (set one or both) ---
# OpenRouter (the default gateway): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Groq (optional, direct, very fast): https://console.groq.com/keys . Used only by models written as "groq:<model id>".
GROQ_API_KEY=

# --- Model chain ---
# A model is an OpenRouter ID ("vendor/model") or "groq:<groq model id>". PRIMARY_MODEL is tried first, then
# FALLBACK_MODEL (comma-separated, in order) on error / timeout / truncated or reasoning-leaking replies.
# Models whose provider has no key are skipped (warning at startup), so one file works with either key.
#
# Default: free OpenRouter models (rate-limited: 50 requests/day on a free account; $10 of credits -> 1000/day).
PRIMARY_MODEL=poolside/laguna-xs-2.1:free
FALLBACK_MODEL=cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free,openrouter/free
# With a Groq key (fast; separate quota from OpenRouter), for example:
#   PRIMARY_MODEL=groq:openai/gpt-oss-120b
#   FALLBACK_MODEL=groq:openai/gpt-oss-20b,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free
# Groq's model list changes; verify IDs with scripts/check_models.py.
# With OpenRouter credits:  PRIMARY_MODEL=openai/gpt-4.1-mini   FALLBACK_MODEL=google/gemini-2.5-flash
# Check IDs/tool support (and optionally probe a real tool call):  python scripts/check_models.py [--probe]

# Password for /admin (HTTP basic auth, any username). Admin is disabled if unset.
ADMIN_PASSWORD=changeme
# SQLite file. Seeded from data/*.csv on boot when missing/empty.
DB_PATH=app.db
